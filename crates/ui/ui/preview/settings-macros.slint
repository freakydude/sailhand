// Preview: the Macros section of the Settings page. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer, SettingsSection } from "../state.slint";
import { Sample } from "sample.slint";

export component SettingsMacrosPreview inherits AppWindow {
    init => {
        Sample.ready-printer();
        Printer.macro-items = [
            { name: "HEAT_SOAK", visible: true },
            { name: "LOAD_FILAMENT", visible: true },
            { name: "PARK", visible: true },
            { name: "PARK_TOOLHEAD_AT_THE_FRONT_CENTER_FOR_NOZZLE_CHECKS", visible: true },
            { name: "PRINT_END", visible: true },
            { name: "PRINT_START", visible: false },
            { name: "SET_PAUSE_AT_LAYER", visible: false },
            { name: "UNLOAD_FILAMENT", visible: true },
        ];
        Navigation.settings-section = SettingsSection.macros;
        Navigation.page = Page.settings;
    }
}
