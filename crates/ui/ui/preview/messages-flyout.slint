// Preview: the messages flyout open: a fault that stands under "Now", two new messages, two earlier ones (one a past
// fault). Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { MessagesFlyout } from "../components/messages-flyout.slint";
import { Navigation, Page, Place, Printer, Severity } from "../state.slint";
import { Sample } from "sample.slint";

export component MessagesFlyoutPreview inherits AppWindow {
    MessagesFlyout {
        width: parent.width;
        height: parent.height;
    }

    init => {
        Navigation.page = Page.temperature;
        Navigation.open-messages();
        Sample.printing();
        Printer.messages-has-now = true;
        Printer.messages-has-new = true;
        Printer.messages-new-top = 94px;
        Printer.messages-has-earlier = true;
        Printer.messages-earlier-top = 236px;
        Printer.messages = [
            { id: 6, text: "Paused · Extruder 170 °C, extrudes from 180 °C", time: "11:35:02", severity: Severity.attention, tinted: true, standing: true, place: Place.print, top: 24px, height: 64px },
            { id: 5, text: "Unknown command:\"G29\"", time: "11:34:12", severity: Severity.error, tinted: true, place: Place.none, top: 118px, height: 42px },
            { id: 4, text: "Must home axis first: 150.000 150.000 20.000 [0.000]", time: "11:32:05", severity: Severity.error, tinted: true, place: Place.none, top: 166px, height: 64px },
            { id: 3, text: "Probe accuracy results: maximum 2.512500, minimum 2.507500, range 0.005000", time: "11:20:41", severity: Severity.info, place: Place.none, top: 260px, height: 64px },
            { id: 2, text: "Spoolman offline", time: "11:12:03", severity: Severity.attention, place: Place.none, top: 330px, height: 42px },
        ];
        Printer.messages-height = 378px;
    }
}
