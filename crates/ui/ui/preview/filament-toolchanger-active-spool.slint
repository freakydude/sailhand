// Preview: the Filament page of a tool changer whose mounted head T1 holds another spool than the active spool of
// Moonraker (Red PLA): the notice under the spool strip. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentToolchangerActiveSpoolPreview inherits AppWindow {
    init => {
        Sample.ready-printer();
        Sample.toolchanger();
        Navigation.page = Page.filament;
        Printer.heads = [
        { name: "T0", label: "T0", subtitle: "", has-nozzle: true, temperature: 24, target: 0, mounted: false, detected: false, lanes: 1, pick-up: "macro", pick-up-macro: "T0", has-spool: true, spool-title: "Red PLA", spool-material: "PLA", spool-weight: "812 g", spool-colors: { first: #ff0000, count: 1 }, spool-id: 1, spool-tool: 0, can-pick-spool: true, path: Sample.head-path },
        { name: "T1", label: "T1", subtitle: "", has-nozzle: true, temperature: 214.6, target: 215, mounted: true, detected: true, lanes: 1, pick-up: "macro", pick-up-macro: "T1", has-spool: true, spool-title: "Blue PLA", spool-material: "PLA", spool-weight: "905 g", spool-colors: { first: #0033ff, count: 1 }, spool-id: 3, spool-tool: 1, can-pick-spool: true, active-spool-differs: true, active-spool-title: "Red PLA", active-spool-colors: { first: #ff0000, count: 1 }, path: Sample.head-path },
        { name: "T2", label: "T2", subtitle: "", has-nozzle: true, temperature: 24, target: 0, mounted: false, detected: false, lanes: 1, pick-up: "macro", pick-up-macro: "T2", has-spool: false, spool-id: -1, spool-tool: 2, can-pick-spool: true, path: Sample.head-path },
        ];
    }
}
