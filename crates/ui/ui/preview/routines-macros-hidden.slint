// Preview: the Macros tab with every macro switched off in Settings. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { RoutinesTab, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component RoutinesMacrosHiddenPreview inherits AppWindow {
    init => {
        Sample.ready-printer();
        Navigation.page = Page.routines;
        Navigation.routines-tab = RoutinesTab.macros;
        Printer.macros = [];
        Printer.macro-items = [
            { name: "HEAT_SOAK", visible: false },
            { name: "LOAD_FILAMENT", visible: false },
            { name: "PARK", visible: false },
        ];
    }
}
