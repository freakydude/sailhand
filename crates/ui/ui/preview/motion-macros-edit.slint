// Preview: the Macros tab while choosing which macros it offers; long names, one switched off. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { MotionTab, Navigation, Page, Printer, MacroRunState } from "../state.slint";
import { Sample } from "sample.slint";
import { Theme } from "../theme.slint";
import { MacrosTab } from "../pages/macros.slint";

export component MotionMacrosEditPreview inherits AppWindow {
    // The edit mode is state of the tab itself, so this tab covers the content area (right of the navigation rail of
    // 76 px, below the status bar of 44 px and the tab bar) over the one the window shows for the Macros tab.
    Rectangle {
        x: 76px;
        y: 44px + Theme.touch + Theme.padding;
        width: parent.width - self.x;
        height: parent.height - self.y;
        background: Theme.background;
        MacrosTab { editing: true; }
    }

    init => {
        Sample.ready-printer();
        Navigation.page = Page.motion;
        Navigation.motion-tab = MotionTab.macros;
        Printer.macros = ["HEAT_SOAK", "LOAD_FILAMENT", "PARK", "PARK_TOOLHEAD_AT_THE_FRONT_CENTER_FOR_NOZZLE_CHECKS", "PRINT_END", "PRINT_START", "UNLOAD_FILAMENT"];
        Printer.macro-items = [
            { name: "HEAT_SOAK", visible: true },
            { name: "SET_PAUSE_AT_LAYER", visible: false },
            { name: "LOAD_FILAMENT", visible: true },
            { name: "PARK", visible: true },
            { name: "PARK_TOOLHEAD_AT_THE_FRONT_CENTER_FOR_NOZZLE_CHECKS", visible: true },
            { name: "PRINT_END", visible: true },
            { name: "PRINT_START", visible: true },
            { name: "UNLOAD_FILAMENT", visible: true },
        ];
        Printer.macro-selected = "PARK_TOOLHEAD_AT_THE_FRONT_CENTER_FOR_NOZZLE_CHECKS";
    }
}
