// The head of a tool changer on the Filament page (docs/multi-tool.md, D7): a chip at the right end of the tab row
// with the colour of the head's spool, `T<n>`, its nozzle temperature and, where the detection found it on the
// carriage, a check; a tap opens the picker (`head-picker.slint`). Beside it the hint says what the tool changer does
// differently, with the button that helps.

import { Theme } from "../theme.slint";
import { Units } from "../units.slint";
import { Icons } from "../icons.slint";
import { Actions, HeadItem, Navigation, Place, Printer, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { IconButton, WrapText } from "controls.slint";
import { JumpHint } from "jump.slint";
import { FilamentSwatch } from "filament-swatch.slint";

export component HeadChip inherits Rectangle {
    in property <HeadItem> head;
    in property <bool> open;
    callback clicked;

    width: 188px;
    height: Theme.touch;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-active : Theme.surface-raised;
    border-width: root.open ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.head.label;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-medium;
        padding-right: Theme.spacing;
        spacing: Theme.spacing-medium;
        FilamentSwatch {
            cross-axis-self-alignment: center;
            width: 5px;
            height: 32px;
            radius: 2px;
            empty: !root.head.has-spool;
            colors: root.head.spool-colors;
        }
        Image {
            cross-axis-self-alignment: center;
            source: Icons.mmu-tool-head;
            colorize: Theme.muted;
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
        Text {
            // A head without a number shows its name, cut at about 98 px.
            max-width: 98px;
            horizontal-stretch: 1;
            text: root.head.label;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.head.has-nozzle: Text {
            overflow: elide;
            text: Units.degrees(root.head.temperature);
            color: Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        if root.head.detected: Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-check;
            colorize: StateIcons.severity-color(Severity.neutral);
            width: Theme.icon-compact;
            height: Theme.icon-compact;
        }
        Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-chevron-down;
            colorize: Theme.muted;
            width: Theme.icon-compact;
            height: Theme.icon-compact;
        }
    }
}

// What the tool changer does differently: the text and the button that helps, in the tab row between the tabs and the
// chip (a line of its own would push the last row of the page out). Changing heads is for a printer whose print is not
// running (a pause is fine) and a changer that is ready. An error has no button here: it leads to the Service tab, where
// the recovery is.
export component ChangerHint inherits HorizontalLayout {
    // Beside the path tabs there is room for two short lines only: smaller text that wraps, a narrower button.
    in property <bool> narrow;
    spacing: Theme.spacing;

    if Printer.changer-note == "error": JumpHint {
        horizontal-stretch: 1;
        severity: Severity.error;
        text: root.narrow ? @tr("Changer error") : @tr("Tool changer error");
        narrow: root.narrow;
        clicked => { Navigation.go(Place.changer-service, ""); }
    }
    if Printer.changer-note != "error": Image {
        cross-axis-self-alignment: center;
        source: Printer.changer-note == "mismatch" ? Icons.ui-warning : Icons.ui-info;
        colorize: StateIcons.severity-color(Printer.changer-note == "mismatch" ? Severity.attention : Severity.info);
        width: Theme.icon-small;
        height: Theme.icon-small;
    }
    if Printer.changer-note != "error": WrapText {
        horizontal-stretch: 1;
        text: Printer.changer-note == "mismatch" ? @tr("{} selected, {} detected", Printer.changer-selected, Printer.changer-detected)
            : @tr("Not initialized");
        color: StateIcons.severity-color(Printer.changer-note == "mismatch" ? Severity.attention : Severity.info);
        font-size: root.narrow ? Theme.font-small : Theme.font-normal;
    }
    if Printer.changer-note == "uninitialized": IconButton {
        icon: Icons.ui-refresh;
        text: @tr("Initialize");
        horizontal: true;
        width: root.narrow ? 130px : 150px;
        enabled: !Printer.motion-locked;
        clicked => { Actions.initialize-toolchanger(false); }
    }
}

// AFC is in its error state: a hint in the tab row like the one of the tool changer; it leads to the AFC service page,
// where "Clear error" is.
export component AfcHint inherits JumpHint {
    severity: Severity.error;
    text: @tr("AFC error");
    clicked => { Navigation.go(Place.afc-service, ""); }
}
