// Temperature history of one heater or sensor: the last minutes from Moonraker, growing while it is open. The chart is
// a component of its own: the dialog of a heater and the PID tab of the Routines page draw it.

import { Theme } from "../theme.slint";
import { Actions, Navigation, Printer } from "../state.slint";
import { DialogHeader, DialogPanel, Scrim } from "dialog.slint";

// A line of the chart. The view box is 1000 high and as wide as the drawing area's shape, because a path is scaled
// evenly; the lines are computed for that shape (`Navigation.history-aspect`).
component ChartLine inherits Path {
    viewbox-width: 1000 * Navigation.history-aspect;
    viewbox-height: 1000;
    stroke-width: 2px;
}

component Legend inherits HorizontalLayout {
    in property <color> color;
    in property <string> text;
    spacing: Theme.spacing-medium;
    Rectangle { cross-axis-self-alignment: center; width: 16px; height: 3px; background: root.color; }
    Text { text: root.text; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
}

// The chart with its labels and legend. Only one chart is on the screen at a time and tells Rust its shape
// (`Navigation.history-aspect`); `active` is false for one that is hidden.
export component TemperatureChart inherits VerticalLayout {
    in property <bool> active: true;
    spacing: Theme.spacing;

    function report-aspect() {
        if (root.active) {
            Navigation.history-aspect = (chart.width - 2 * Theme.dialog-inset) / max(1px, chart.height - 2 * Theme.dialog-inset);
        }
    }
    changed active => { root.report-aspect(); }

    // Temperature labels left of the chart, time labels below it; both at the grid lines.
    HorizontalLayout {
        spacing: Theme.spacing;
        vertical-stretch: 1;
        temperature-axis := Rectangle {
            width: 56px;
            for label in Printer.history-temperature-labels: Text {
                overflow: elide;
                x: 0;
                y: Theme.dialog-inset + (parent.height - 2 * Theme.dialog-inset) * label.position - 8px;
                width: parent.width;
                height: 16px;
                text: label.text;
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        chart := Rectangle {
            horizontal-stretch: 1;
            init => { root.report-aspect(); }
            changed width => { root.report-aspect(); }
            changed height => { root.report-aspect(); }
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            ChartLine {
                x: Theme.dialog-inset;
                y: Theme.dialog-inset;
                width: parent.width - 2 * Theme.dialog-inset;
                height: parent.height - 2 * Theme.dialog-inset;
                commands: Printer.history-grid-path;
                stroke: Theme.border;
                stroke-width: 1px;
            }
            ChartLine {
                x: Theme.dialog-inset;
                y: Theme.dialog-inset;
                width: parent.width - 2 * Theme.dialog-inset;
                height: parent.height - 2 * Theme.dialog-inset;
                commands: Printer.history-power-path;
                stroke: Theme.chart-secondary;
            }
            ChartLine {
                x: Theme.dialog-inset;
                y: Theme.dialog-inset;
                width: parent.width - 2 * Theme.dialog-inset;
                height: parent.height - 2 * Theme.dialog-inset;
                commands: Printer.history-target-path;
                stroke: Theme.muted;
            }
            ChartLine {
                x: Theme.dialog-inset;
                y: Theme.dialog-inset;
                width: parent.width - 2 * Theme.dialog-inset;
                height: parent.height - 2 * Theme.dialog-inset;
                commands: Printer.history-temperature-path;
                stroke: Theme.accent;
                stroke-width: 3px;
            }
            if Printer.history-temperature-path == "": Text {
                overflow: elide;
                text: @tr("Loading the history from Moonraker …");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.spacing;
        height: 18px;
        Rectangle { width: temperature-axis.width; }
        Rectangle {
            horizontal-stretch: 1;
            for label in Printer.history-time-labels: Text {
                overflow: elide;
                x: Theme.dialog-inset + (parent.width - 2 * Theme.dialog-inset) * label.position - self.width / 2;
                width: 60px;
                text: label.text;
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
            }
            Text {
                overflow: elide;
                x: parent.width - 8px - self.width / 2;
                text: @tr("now");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
        }
    }

    HorizontalLayout {
        spacing: 2 * Theme.spacing;
        alignment: end;
        Legend { color: Theme.accent; text: @tr("Temperature"); }
        if Printer.history-target-path != "": Legend { color: Theme.muted; text: @tr("Target"); }
        if Printer.history-power-path != "": Legend { color: Theme.chart-secondary; text: @tr("Power"); }
    }
}

export component HistoryDialog inherits Scrim {
    visible: Navigation.history-open;

    DialogPanel {
        x: Theme.dialog-inset;
        y: Theme.dialog-inset;
        width: parent.width - 2 * Theme.dialog-inset;
        height: parent.height - 2 * Theme.dialog-inset;
        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: Printer.history-title;
                close => { Actions.close-history(); }
                Text {
                    overflow: elide;
                    text: Printer.history-current;
                    color: Theme.accent;
                    font-size: Theme.font-large;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
            TemperatureChart {
                vertical-stretch: 1;
                active: Navigation.history-open;
            }
        }
    }
}
