// Application frame: status bar at the top, navigation rail on the left.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Backlight, Confirm, Dialogs, Navigation, Network, Page, Place, Printer, PrinterChoice, Severity } from "../state.slint";
import { StateIcons } from "../state-icons.slint";
import { BusyWheel } from "busy-wheel.slint";

// A temperature of the status bar; a tap leads to the heaters without looking like a button.
component TemperatureReading inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> heating;
    // The name of the head this reading belongs to, shown before the icon; empty for none.
    in property <string> head;
    min-width: reading.min-width;
    preferred-width: reading.preferred-width;

    TouchArea {
        clicked => {
            Dialogs.dismiss();
            Navigation.show-heaters();
        }
    }

    reading := HorizontalLayout {
        spacing: Theme.spacing-small;
        if root.head != "": Text {
            text: root.head;
            color: Theme.muted;
            font-size: Theme.font-normal;
            vertical-alignment: center;
            overflow: elide;
            max-width: 56px;
        }
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.heating ? Theme.accent : Theme.muted;
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
    }
}

// Counter of the errors and informations not seen yet; it stays until the message list is opened. One shape for
// both, a pale ground and the symbol in the colour of the more serious kind among them.
component UnreadCounter inherits Rectangle {
    in property <int> count;
    in property <Severity> severity;
    width: counter-row.preferred-width;
    border-radius: self.height / 2;
    background: StateIcons.severity-tint(root.severity);
    counter-row := HorizontalLayout {
        padding-left: Theme.spacing-medium;
        padding-right: Theme.spacing;
        spacing: Theme.spacing-small;
        Image {
            cross-axis-self-alignment: center;
            source: StateIcons.severity-icon(root.severity);
            colorize: StateIcons.severity-color(root.severity);
            width: Theme.icon-compact;
            height: Theme.icon-compact;
        }
        Text {
            text: root.count;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// The fault that stands, as long as its state lasts: a pale chip in its colour with its symbol and short name. A tap
// leads to the place where it is dealt with.
component FaultChip inherits Rectangle {
    height: 32px;
    min-width: chip-row.min-width;
    preferred-width: chip-row.preferred-width;
    border-radius: Theme.radius-small;
    background: chip-touch.pressed ? Theme.surface-active : StateIcons.severity-tint(Printer.fault-severity);
    accessible-role: button;
    accessible-label: Printer.fault-label;
    chip-touch := TouchArea {
        clicked => { Navigation.go(Printer.fault-place, ""); }
    }
    chip-row := HorizontalLayout {
        padding-left: Theme.spacing;
        padding-right: Theme.spacing-medium;
        spacing: Theme.spacing-small;
        Image {
            cross-axis-self-alignment: center;
            source: StateIcons.severity-icon(Printer.fault-severity);
            colorize: StateIcons.severity-color(Printer.fault-severity);
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
        Text {
            min-width: self.preferred-width;
            text: Printer.fault-label;
            color: Theme.foreground;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
        }
        if Printer.fault-more > 0: Text {
            text: "+" + Printer.fault-more;
            color: Theme.muted;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component StatusBar inherits Rectangle {
    // The one place for what is running right now: a command of this display that waits long for its answer, what
    // the MMU is doing (whoever started it), or the network being changed.
    property <string> activity: Printer.running-command != "" ? Printer.running-command
        : Printer.mmu-action != "" && Printer.mmu-action != "Idle" ? Printer.mmu-action
        : Network.busy;
    property <Severity> severity: StateIcons.summary-severity();
    property <bool> shows-progress: !StateIcons.print-page-open() && Printer.ready && (Printer.print-state == "printing" || Printer.print-state == "paused");
    // A long printer name is shortened; the state beside it needs the room.
    property <length> printer-name-max-width: 160px;
    property <length> counter-height: 28px;

    height: 44px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.spacing-small;
        padding-right: Theme.spacing-tight;
        spacing: Theme.spacing-large;

        // State and messages in one field. The state rests here, a standing fault as a chip before it; an event (a
        // fault that begins, an error or an information) lies over the whole width up to the counter for a while; a
        // tap opens the message list, or closes it.
        field := Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius;
            background: field-touch.pressed || Navigation.messages-open ? Theme.surface-active
                : Printer.status-message-visible ? StateIcons.severity-tint(Printer.status-message-severity) : transparent;
            accessible-role: button;
            accessible-label: Printer.status-message-visible ? Printer.status-message : StateIcons.summary-label();
            field-touch := TouchArea {
                clicked => {
                    if (Navigation.messages-open) {
                        Navigation.close-messages();
                    } else {
                        Dialogs.dismiss();
                        Navigation.open-messages();
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.spacing-medium;
                padding-right: Theme.spacing-medium;
                spacing: Theme.spacing;
                // The rows below hold icons of fixed height, which caps their height; without this they sit at the top.
                cross-axis-alignment: center;

                if Printer.status-message-visible: HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing;
                    Image {
                        cross-axis-self-alignment: center;
                        source: StateIcons.severity-icon(Printer.status-message-severity);
                        colorize: StateIcons.severity-color(Printer.status-message-severity);
                        width: Theme.icon-large;
                        height: Theme.icon-large;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Printer.status-message;
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // While something runs, the turning wheel and its name replace the state.
                if !Printer.status-message-visible && root.activity != "": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing-medium;
                    BusyWheel {
                        cross-axis-self-alignment: center;
                        width: 40px;
                        height: 40px;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.activity + " …";
                        color: Theme.foreground;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if !Printer.status-message-visible && root.activity == "": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing;
                    if Printer.fault-visible: FaultChip {
                        cross-axis-self-alignment: center;
                    }
                    if !Printer.fault-visible || !Printer.fault-is-state: Image {
                        cross-axis-self-alignment: center;
                        source: StateIcons.summary();
                        colorize: StateIcons.severity-color(root.severity);
                        width: Theme.icon-large;
                        height: Theme.icon-large;
                    }
                    // The progress of a print stays whole when the detail is shortened.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing;
                        if StateIcons.summary-label() != "" && !(Printer.fault-visible && Printer.fault-is-state): Text {
                            min-width: self.preferred-width;
                            text: StateIcons.summary-label();
                            color: StateIcons.label-color(root.severity);
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if StateIcons.summary-value() != "": Text {
                            min-width: self.preferred-width;
                            text: StateIcons.summary-value();
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: StateIcons.summary-detail();
                            color: Theme.muted;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Which printer this is, when there is a choice; it stays while activities come and go.
                if !Printer.status-message-visible && PrinterChoice.several-saved && PrinterChoice.active-name != "": Text {
                    max-width: root.printer-name-max-width;
                    text: PrinterChoice.active-name;
                    color: Theme.muted;
                    font-size: Theme.font-normal;
                    vertical-alignment: center;
                    overflow: elide;
                }

            }

            // Progress of the print along the lower edge: light on dark while it runs, grey while it stands. Not the accent:
            // beside a tinted message or fault chip the orange clashed (Frank 2026-11-26).
            if root.shows-progress: Rectangle {
                x: 6px;
                y: parent.height - 4px;
                width: parent.width - 12px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.surface-active;
                Rectangle {
                    x: 0;
                    width: parent.width * Printer.progress;
                    border-radius: 1.5px;
                    background: Printer.print-state == "printing" ? Theme.foreground : Theme.muted;
                }
            }
        }

        // A message takes the room of the readings while it is shown; they come back when it leaves.
        if Printer.ready && !Printer.status-message-visible: TemperatureReading {
            icon: Icons.thermal-nozzle;
            head: Printer.nozzle-head;
            heating: Printer.nozzle-selected && Printer.nozzle-target > 0;
            text: !Printer.nozzle-selected ? @tr("No head") : Printer.nozzle-bar-text;
        }
        if Printer.has-bed && Printer.ready && !Printer.status-message-visible: TemperatureReading {
            icon: Icons.thermal-bed;
            heating: Printer.bed-target > 0;
            text: Printer.bed-bar-text;
        }
        if Printer.has-chamber && Printer.ready && !Printer.status-message-visible: TemperatureReading {
            icon: Icons.thermal-chamber;
            heating: Printer.chamber-heating;
            text: Printer.chamber-bar-text;
        }
        // In a column with room above and below, like the emergency stop: directly in the row, its fixed height would
        // cap the height of the whole row and lift the field and the readings.
        if Printer.unread-count > 0: VerticalLayout {
            padding-top: (root.height - root.counter-height) / 2;
            padding-bottom: self.padding-top;
            UnreadCounter {
                height: root.counter-height;
                count: Printer.unread-count;
                severity: Printer.unread-severity;
            }
        }
        // Opens the light panel; lit while the main light (chamber or case light) is on. A controllable backlight
        // of the display is reason enough, also without a ready printer.
        if (Printer.leds.length > 0 && Printer.ready) || Backlight.available: Rectangle {
            width: Theme.touch;
            border-radius: Theme.radius;
            background: light-touch.pressed ? Theme.surface-raised : transparent;
            accessible-role: button;
            accessible-label: @tr("Light");
            light-touch := TouchArea {
                clicked => {
                    Dialogs.dismiss();
                    Navigation.light-open = !Navigation.light-open;
                }
            }
            Image {
                source: Icons.accessory-light;
                colorize: Printer.light-on ? Theme.accent : Theme.muted;
                width: Theme.icon-large;
                height: Theme.icon-large;
            }
        }
        VerticalLayout {
            padding-top: Theme.spacing-tight;
            padding-bottom: Theme.spacing-tight;
            Rectangle {
                width: 64px;
                border-radius: Theme.radius;
                background: stop-touch.pressed ? Theme.danger-fill-pressed : Theme.danger-fill;
                accessible-role: button;
                accessible-label: @tr("Emergency stop");
                stop-touch := TouchArea {
                    clicked => {
                        Dialogs.dismiss();
                        Confirm.ask(@tr("Emergency stop"), @tr("Stops all motors and heaters immediately. Klipper must be restarted afterwards."), "emergency-stop", "", true);
                    }
                }
                Image {
                    source: Icons.system-emergency-stop;
                    colorize: Theme.foreground;
                    width: Theme.icon;
                    height: Theme.icon;
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <Page> page;
    in property <bool> enabled: true;
    // Something needs a look: a small dot in the top right corner.
    in property <bool> warn;
    // System stays marked on its pages below (updates, printers, settings, network, console), so a tap leads back.
    property <bool> active: Navigation.page == root.page || (root.page == Page.system
        && (Navigation.page == Page.console || Navigation.page == Page.settings || Navigation.page == Page.updates
            || Navigation.page == Page.network || Navigation.page == Page.printers));
    property <color> content: !root.enabled ? Theme.disabled-foreground : root.active ? Theme.accent : Theme.foreground;

    border-radius: Theme.radius;
    // The chosen page on the raised surface: the accent label stays readable there (on `surface-active` it is not).
    background: nav-touch.pressed ? Theme.surface-active : root.active ? Theme.surface-raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;

    nav-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            Dialogs.dismiss();
            Navigation.page = root.page;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing-tight;
        Image {
            cross-axis-self-alignment: center;
            source: root.icon;
            colorize: root.content;
            width: Theme.icon-nav;
            height: Theme.icon-nav;
        }
        Text {
            text: root.label;
            color: root.content;
            font-size: Theme.font-label;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.warn: Rectangle {
        x: parent.width - self.width - 10px;
        y: 6px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: StateIcons.severity-color(Severity.attention);
    }
}

export component NavRail inherits Rectangle {
    width: 76px;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.spacing-small;
        spacing: Theme.spacing-tight;
        NavItem { icon: Icons.nav-printer; label: @tr("Print"); enabled: Printer.ready; }
        NavItem { icon: Icons.nav-move; label: @tr("Motion"); page: Page.motion; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-thermal; label: @tr("Thermal"); page: Page.temperature; enabled: Printer.ready; }
        NavItem { icon: Icons.nav-filament; label: @tr("Filament"); page: Page.filament; enabled: Printer.ready; }
        if Printer.has-changer: NavItem { icon: Icons.nav-changer; label: @tr("Changer"); page: Page.changer; enabled: Printer.ready; warn: Printer.has-changer-sensors && Printer.filament-sensor-runout; }
        NavItem { icon: Icons.nav-system; label: @tr("System"); page: Page.system; }
    }
}
