// Jumps instead of buttons in messages and hints (Frank 2026-11-26): a hint says what is the matter and leads to the
// place where it is dealt with; that place lights up for a moment.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { StateIcons } from "../state-icons.slint";
import { Navigation, Place, Severity } from "../state.slint";

// Lights up the element it lies over when a jump leads to `place` (and, if set, `name`), then fades and clears the
// jump. Put it as the last child of a Rectangle that has no layout, so it covers it: `Highlight { place: ...; }`.
export component Highlight inherits Rectangle {
    in property <Place> place;
    // The heater, head or lane of the place; empty matches any.
    in property <string> name;
    // How long the mark stays before it fades.
    property <duration> lit-time: 1600ms;
    property <bool> lit: Navigation.highlight == root.place && (root.name == "" || Navigation.highlight-name == root.name);
    // Without a layout around it, a Rectangle fills its parent by default.
    border-radius: Theme.radius;
    border-width: 3px;
    border-color: Theme.accent;
    background: Theme.accent.with-alpha(0.12);
    opacity: 0;
    states [
        on when root.lit: {
            opacity: 1;
            out {
                animate opacity { duration: 500ms; }
            }
        }
    ]
    Timer {
        interval: root.lit-time;
        running: root.lit;
        triggered => { Navigation.highlight-done(); }
    }
}

// A hint that leads somewhere: a pale ground in the colour of its severity, its symbol, the text and an arrow; the
// whole row is the touch area. No button of its own: the place it leads to has the controls.
export component JumpHint inherits Rectangle {
    in property <Severity> severity;
    in property <string> text;
    // A smaller text for a narrow place (beside tabs); it may wrap to two lines.
    in property <bool> narrow;
    callback clicked();
    min-height: Theme.row-height-small;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-active : StateIcons.severity-tint(root.severity);
    accessible-role: button;
    accessible-label: root.text;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Theme.spacing-medium;
        padding-right: Theme.spacing;
        spacing: Theme.spacing;
        Image {
            cross-axis-self-alignment: center;
            source: StateIcons.severity-icon(root.severity);
            colorize: StateIcons.severity-color(root.severity);
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.text;
            color: Theme.foreground;
            font-size: root.narrow ? Theme.font-small : Theme.font-normal;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
        Image {
            cross-axis-self-alignment: center;
            source: Icons.ui-chevron-right;
            colorize: Theme.muted;
            width: Theme.icon-small;
            height: Theme.icon-small;
        }
    }
}
