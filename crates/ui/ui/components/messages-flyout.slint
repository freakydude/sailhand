// Flyout below the status bar with all errors and informations.

import { Theme } from "../theme.slint";
import { StateIcons } from "../state-icons.slint";
import { Icons } from "../icons.slint";
import { Actions, Navigation, Printer } from "../state.slint";
import { FlyoutPanel, IconButton, ScrollList } from "controls.slint";
import { DialogHeader } from "dialog.slint";

component SectionHeading inherits Text {
    overflow: elide;
    color: Theme.muted;
    font-size: Theme.font-small;
    font-weight: 600;
    height: 18px;
    vertical-alignment: center;
}

// Flyout below the field of the status bar with every incident: the faults that stand under "Now", then newest first
// what came since the last time under "New", the rest under "Earlier". The page beside it stays covered by a tap catcher: a tap
// there closes the flyout and does nothing else, like a menu. Every way out goes through `Navigation.close-messages()`.
export component MessagesFlyout inherits Rectangle {
    // Height of one text line of a row (`LINE_HEIGHT` in crates/app/src/status_log.rs): symbol, time and arrow sit
    // in this band, level with the first line of a text that wraps.
    property <length> line-band: 22px;
    // Everything but the status bar, so that its field, the light and the emergency stop stay in reach.
    TouchArea {
        width: Theme.nav-rail-width;
        clicked => { Navigation.close-messages(); }
    }
    TouchArea {
        x: Theme.nav-rail-width;
        y: Theme.status-bar-height;
        width: root.width - self.x;
        height: root.height - self.y;
        clicked => { Navigation.close-messages(); }
    }

    FlyoutPanel {
        x: Theme.nav-rail-width + Theme.spacing;
        y: Theme.status-bar-height + Theme.spacing;
        width: min(520px, root.width - self.x - Theme.spacing);
        height: root.height - self.y - Theme.spacing;

        VerticalLayout {
            padding: Theme.padding;
            spacing: Theme.spacing;
            DialogHeader {
                title: @tr("Messages");
                close => { Navigation.close-messages(); }
                // Nothing is left to read: the flyout closes with it.
                IconButton {
                    width: Theme.touch;
                    icon: Icons.ui-delete;
                    accessible-label: @tr("Clear the messages");
                    enabled: Printer.messages.length > 0;
                    clicked => {
                        Actions.messages-clear();
                        Navigation.close-messages();
                    }
                }
            }

            messages-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.messages-height;
                if Printer.messages-has-now: SectionHeading {
                    x: 0;
                    y: 0;
                    width: messages-list.row-width;
                    text: @tr("NOW");
                }
                if Printer.messages-has-new: SectionHeading {
                    x: 0;
                    y: Printer.messages-new-top;
                    width: messages-list.row-width;
                    text: @tr("NEW");
                }
                if Printer.messages-has-earlier: SectionHeading {
                    x: 0;
                    y: Printer.messages-earlier-top;
                    width: messages-list.row-width;
                    text: @tr("EARLIER");
                }
                // What still asks to be looked at lies on a pale ground in its colour; the rest is history with only
                // its symbol in colour. Every message leads somewhere: where it is dealt with, the routine it came
                // from, else the console where it happened.
                for message in Printer.messages: Rectangle {
                    x: 0;
                    y: message.top;
                    width: messages-list.row-width;
                    height: message.height;
                    background: row-touch.pressed ? Theme.surface-active
                        : message.tinted ? StateIcons.severity-tint(message.severity) : Theme.surface-raised;
                    border-radius: Theme.radius;
                    row-touch := TouchArea {
                        clicked => { Navigation.go(message.place, message.place-name); }
                    }
                    HorizontalLayout {
                        padding: Theme.padding;
                        spacing: Theme.spacing;
                        Image {
                            source: StateIcons.severity-icon(message.severity);
                            colorize: StateIcons.severity-color(message.severity);
                            width: Theme.icon-small;
                            height: root.line-band;
                            image-fit: contain;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: message.text;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: message.tinted ? 600 : 400;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        Text {
                            overflow: elide;
                            height: root.line-band;
                            text: message.standing ? @tr("since {}", message.time) : message.time;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Image {
                            source: Icons.ui-chevron-right;
                            colorize: Theme.muted;
                            width: Theme.icon-small;
                            height: root.line-band;
                            image-fit: contain;
                        }
                    }
                }
            }
        }
    }
}
