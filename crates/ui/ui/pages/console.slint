// G-code console: the log and a command field that opens the on-screen keyboard. Whether temperature reports are
// shown is switched here too. Macros live on Routines › Macros. A message of the flyout leads to the row it happened
// at (`Printer.console-target`).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Place, Printer, UiSettings } from "../state.slint";
import { IconButton, ScrollList, ToggleRow } from "../components/controls.slint";
import { ConsoleRow, ConsoleRows } from "../components/console-row.slint";
import { TextEntryDialog } from "../components/entry-dialogs.slint";
import { Highlight } from "../components/jump.slint";
import { SystemTabs } from "../components/system-tabs.slint";

export component ConsolePage inherits Rectangle {
    property <length> line-height: ConsoleRows.height;
    property <string> draft;

    init => { Actions.load-console(); }
    changed console-target => { root.show-target(); }

    property <int> console-target: Printer.console-target;

    function show-target() {
        if (root.console-target >= 0) {
            log.show-row(4px + root.console-target * root.line-height, root.line-height);
        }
    }

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;
        SystemTabs { }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: Theme.radius;
            clip: true;
            log := ScrollList {
                x: 8px;
                width: parent.width - 12px;
                height: parent.height;
                content-height: Printer.console.length * root.line-height + 8px;
                // Newest lines at the bottom; jump to the end when opened.
                offset: min(0px, self.height - self.content-height);
                for line[index] in Printer.console: Rectangle {
                    y: 4px + index * root.line-height;
                    height: root.line-height;
                    width: log.row-width;
                    ConsoleRow { line: line; }
                    if Printer.console-target-exact && index == Printer.console-target: Highlight {
                        place: Place.console;
                        radius: Theme.radius-small;
                    }
                    // A sent command can be put back into the field: tap it, then Enter runs it again.
                    if line.is-command: TouchArea {
                        clicked => {
                            root.draft = line.text;
                            entry.open = true;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            height: Theme.touch;
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.draft == "" ? @tr("Enter G-code") : root.draft;
                    color: root.draft == "" ? Theme.disabled-foreground : Theme.foreground;
                    font-size: Theme.font-normal;
                    font-family: "monospace";
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    clicked => { entry.open = true; }
                }
            }
            // Marked while the temperature reports a heater sends during M109/M190 are shown; hidden by default.
            ToggleRow {
                width: 224px;
                icon: Icons.nav-temperature;
                text: @tr("Temperatures");
                checked: !UiSettings.hide-temperature-reports;
                toggled => {
                    UiSettings.hide-temperature-reports = !UiSettings.hide-temperature-reports;
                    UiSettings.hide-temperature-reports-toggled(UiSettings.hide-temperature-reports);
                }
            }
            IconButton {
                icon: Icons.ui-delete;
                width: Theme.touch;
                accessible-label: @tr("Clear the console");
                clicked => { Actions.clear-console(); }
            }
        }
    }

    entry := TextEntryDialog {
        title: @tr("G-code");
        text <=> root.draft;
        accepted(text) => {
            root.draft = "";
            if (text != "") { Actions.run-gcode(text); }
        }
    }
}
