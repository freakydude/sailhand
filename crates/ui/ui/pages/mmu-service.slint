// The MMU part of the Service tab of the Changer page: the commands for the MMU as a whole, rarely needed.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Printer } from "../state.slint";
import { ButtonKind, IconButton } from "../components/controls.slint";
import { GateCheck } from "mmu-dialogs.slint";

export component MmuServiceTab inherits Rectangle {
    // Large tiles, like the extrude buttons of the Extruder tab; compact (icon beside the text, touch height) where
    // another card shares the tab (the tool changer's), so both fit.
    in property <bool> compact;
    property <length> tile-icon: root.compact ? Theme.icon-large : 40px;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        // Recover and Unlock stay: they are what a paused print needs. The rest moves selector, servo or filament.
        if Printer.motion-locked: Text {
            overflow: elide;
            text: @tr("Not while printing");
            color: Theme.muted;
            font-size: Theme.font-small;
        }
        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: root.compact ? 0 : 1;
            IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.mmu-home;
                text: @tr("Home");
                kind: Printer.mmu-homed ? ButtonKind.normal : ButtonKind.accent;
                enabled: !Printer.motion-locked;
                done: Printer.mmu-homed;
                clicked => { Actions.mmu-home(); }
            }
            IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.mmu-recover;
                text: @tr("Recover");
                kind: Printer.mmu-paused ? ButtonKind.accent : ButtonKind.normal;
                clicked => { Actions.mmu-recover(); }
            }
            IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.ui-unlock;
                text: @tr("Unlock");
                kind: Printer.mmu-locked ? ButtonKind.accent : ButtonKind.normal;
                clicked => { Actions.mmu-unlock(); }
            }
            IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.motion-steppers-off;
                text: @tr("Motors off");
                enabled: !Printer.motion-locked;
                clicked => {
                    Confirm.ask(@tr("MMU motors off"), @tr("The MMU can be moved by hand; the selector loses its position and must be homed again."), "mmu-motors-off", "", false);
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: root.compact ? 0 : 1;
            IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                horizontal-stretch: 2;
                icon: Icons.mmu-check-gate;
                text: @tr("Check all gates");
                enabled: !Printer.motion-locked;
                clicked => {
                    if (Printer.mmu-filament != "unloaded") {
                        GateCheck.ask(@tr("Check all gates"), "mmu-check-all-gates", "");
                    } else {
                        Actions.mmu-check-all-gates();
                    }
                }
            }
            if Printer.mmu-servo != "": IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.mmu-servo-up;
                text: @tr("Servo up");
                checked: Printer.mmu-servo == "up";
                enabled: !Printer.motion-locked;
                clicked => { Actions.mmu-servo-up(); }
            }
            if Printer.mmu-servo != "": IconButton {
                horizontal: root.compact;
                icon-size: root.tile-icon;
                icon: Icons.mmu-servo-down;
                text: @tr("Servo down");
                checked: Printer.mmu-servo == "down";
                enabled: !Printer.motion-locked;
                clicked => { Actions.mmu-servo-down(); }
            }
        }
    }
}
